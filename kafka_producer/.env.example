# ==============================================================================
# FinGuard Configuration (100% Free Tiers)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KAFKA CLUSTER (Option A: Upstash Kafka [Free Forever, No Credit Card Required])
#    Sign up at https://upstash.com -> Create Kafka Cluster -> Copy Kafka credentials
# ------------------------------------------------------------------------------
# BOOTSTRAP_SERVERS=your-endpoint.upstash.io:9092
# API_KEY=your_upstash_key
# API_SECRET=your_upstash_secret

# ------------------------------------------------------------------------------
# 1. KAFKA CLUSTER (Option B: Confluent Cloud [$400 Free Credits])
#    Sign up at https://confluent.cloud -> Create Basic Cluster -> API Keys
# ------------------------------------------------------------------------------
BOOTSTRAP_SERVERS=pkc-xrnwx.asia-south2.gcp.confluent.cloud:9092
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
TOPIC_NAME=credit_card_transactions

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL (Free Forever - https://neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/finguard?sslmode=require

# ------------------------------------------------------------------------------
# 3. REAL-TIME EMAIL ALERTING (Gmail SMTP - Free)
#    Generate 16-character App Password at https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
EMAIL_FROM=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# 4. SIMULATION SETTINGS
# ------------------------------------------------------------------------------
TRANSACTIONS_PER_SECOND=2
FRAUD_PERCENTAGE=0.08
TOTAL_CUSTOMERS=1000
TOTAL_MERCHANTS=200
RANDOM_SEED=42

# ------------------------------------------------------------------------------
# 5. DATABRICKS WORKSPACE (Optional for Databricks automation)
# ------------------------------------------------------------------------------
DATABRICKS_HOST=https://adb-123456789.azuredatabricks.net
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxx
